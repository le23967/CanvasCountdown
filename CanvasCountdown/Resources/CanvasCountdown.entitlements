<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- So an update can be put where downloads go, and found again later.
         The app cannot replace itself: it is sandboxed, so /Applications is
         out of reach. Downloads is the one folder where leaving a disk image
         is both allowed and unsurprising. -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
</dict>
</plist>
