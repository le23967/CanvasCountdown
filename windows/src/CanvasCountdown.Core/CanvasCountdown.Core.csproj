<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Everything that decides what the app does, with no Windows dependency, so
    it builds and is tested on any machine. The WinUI project is a thin shell
    over this.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CanvasCountdown</RootNamespace>
    <AssemblyName>CanvasCountdown.Core</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CanvasCountdown.Core.Tests" />
  </ItemGroup>
</Project>
