<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CanvasCountdown.App.Views.AssignmentListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:CanvasCountdown.App"
    xmlns:core="using:CanvasCountdown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The next deadline, large: the reason the app exists. -->
        <!-- A Border is invisible to UI Automation, so the card's title
             carries the name tools and Narrator find it by. -->
        <Border
            x:Name="NextDeadlineCard"
            Margin="24,4,24,14"
            Padding="22"
            CornerRadius="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Visibility="Collapsed">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="CardCount" VerticalAlignment="Center" MinWidth="76">
                    <TextBlock
                        x:Name="CardDays"
                        HorizontalAlignment="Center"
                        FontSize="54"
                        FontWeight="Bold"
                        LineHeight="58" />
                    <TextBlock
                        x:Name="CardDayLabel"
                        HorizontalAlignment="Center"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock
                        Text="Next deadline"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        x:Name="CardTitle"
                        AutomationProperties.AutomationId="NextDeadlineCard"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        TextWrapping="Wrap"
                        MaxLines="2" />
                    <TextBlock
                        x:Name="CardDetails"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Above the calendar the full card would push the weeks off the
             window, so it shrinks to one line there. -->
        <TextBlock
            x:Name="CompactNextDeadline"
            AutomationProperties.AutomationId="CompactNextDeadline"
            Margin="24,0,24,10"
            Visibility="Collapsed"
            TextTrimming="CharacterEllipsis" />

        <ListView
            x:Name="Items"
            Grid.Row="1"
            AutomationProperties.AutomationId="AssignmentList"
            Padding="12,0,12,12"
            SelectionMode="Single"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            SelectionChanged="OnSelectionChanged"
            KeyDown="OnListKeyDown">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:AssignmentRowPresentation">
                    <Grid
                        Padding="0,7"
                        ColumnSpacing="12"
                        Background="Transparent"
                        AutomationProperties.Name="{x:Bind AccessibilityLabel}"
                        ContextRequested="OnRowContextRequested">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- A stripe rather than a dot: it reads at a glance down a
                             long list, and takes no width from the title. -->
                        <Rectangle
                            Width="3"
                            Height="34"
                            RadiusX="1.5"
                            RadiusY="1.5"
                            Fill="{x:Bind app:Palette.FromHex(LabelColorHex)}"
                            Visibility="{x:Bind app:Show.IfText(LabelColorHex)}" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{x:Bind app:Palette.ForTone(Tone)}"
                                Text="{x:Bind DayCountText}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind DayCaption}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis"
                                    Foreground="{x:Bind app:Palette.ForTitle(Item.IsIgnored)}"
                                    Text="{x:Bind Item.Title}" />
                                <TextBlock
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Text="Completed"
                                    Visibility="{x:Bind app:Show.If(Item.IsCompleted)}" />
                                <TextBlock
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Ignored"
                                    Visibility="{x:Bind app:Show.If(Item.IsIgnored)}" />
                            </StackPanel>
                            <TextBlock
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                Text="{x:Bind app:Text.RowDetails(LabelName, CourseText, DueText)}" />
                        </StackPanel>

                        <Button
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Padding="10,4"
                            Content="Actions"
                            Style="{ThemeResource DefaultButtonStyle}"
                            AutomationProperties.Name="{x:Bind app:Text.ActionsFor(Item.Title)}"
                            ToolTipService.ToolTip="Quick actions"
                            Click="OnActionsClick" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            AutomationProperties.AutomationId="EmptyState"
            MaxWidth="440"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="10"
            Visibility="Collapsed">
            <FontIcon x:Name="EmptyGlyph" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center" />
            <TextBlock
                x:Name="EmptyDescription"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel x:Name="EmptyActions" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,6,0,0">
                <Button x:Name="EmptyRefresh" Content="Refresh Now" Click="OnEmptyRefresh" />
                <Button x:Name="EmptyConnect" Content="Connect Canvas…" Style="{ThemeResource AccentButtonStyle}" Click="OnEmptyConnect" />
                <Button x:Name="EmptyAdd" Content="Add Manual Event" Click="OnEmptyAdd" />
                <Button x:Name="EmptyScreenshot" Content="Import from Screenshot…" Click="OnEmptyScreenshot" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
