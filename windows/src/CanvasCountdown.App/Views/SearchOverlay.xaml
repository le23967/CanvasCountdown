<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CanvasCountdown.App.Views.SearchOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:CanvasCountdown.App"
    xmlns:views="using:CanvasCountdown.App.Views">

    <!-- Over everything, including the toolbar: nothing behind it is taken
         away to make room, and the list underneath is not rearranged. -->
    <Grid Visibility="{x:Bind app:Show.If(ViewModel.IsSearchModeActive), Mode=OneWay}">
        <Rectangle
            Fill="{ThemeResource SmokeFillColorDefaultBrush}"
            Tapped="OnBackdropTapped"
            AutomationProperties.Name="Close search" />
        <Border
            AutomationProperties.AutomationId="SearchPanel"
            Width="560"
            MaxWidth="560"
            Margin="16,72,16,16"
            Padding="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            CornerRadius="10"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBox
                    x:Name="Query"
                    AutomationProperties.AutomationId="SearchField"
                    AutomationProperties.Name="Search assignments and courses"
                    PlaceholderText="Search assignments and courses"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PreviewKeyDown="OnQueryKeyDown" />

                <ListView
                    x:Name="Results"
                    AutomationProperties.AutomationId="SearchResults"
                    MaxHeight="440"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="OnResultClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="views:SearchResultRow">
                            <Grid Padding="0,6" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AccessibilityLabel}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{x:Bind Title}" />
                                    <TextBlock
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{x:Bind Subtitle}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Remaining}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    x:Name="NoMatches"
                    Margin="4,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="Collapsed" />

                <TextBlock
                    Margin="4,0"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="Up and Down to move · Enter to open · Esc to close" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
