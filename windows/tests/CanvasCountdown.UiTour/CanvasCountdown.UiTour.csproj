<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Drives a published, isolated copy of the app the way a person would and
    photographs the window at each step. Run on Windows only (CI does), and
    never against a real install: it launches the app with
    CANVAS_COUNTDOWN_ISOLATED_LAUNCH=1 and invented demo coursework.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>CanvasCountdown.UiTour</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.15" />
  </ItemGroup>
</Project>
